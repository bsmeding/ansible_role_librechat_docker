# LibreChat Docker Compose - Generated by Ansible
# Source: https://github.com/danny-avila/LibreChat
# Do not edit directly; use host_vars/group_vars to override.

networks:
  librechat_net:
    driver: bridge

services:
  api:
    container_name: LibreChat
    networks:
      - librechat_net
    ports:
      - "{{ librechat__port }}:{{ librechat__port }}"
    depends_on:
      mongodb:
        condition: service_healthy
      meilisearch:
        condition: service_healthy
      rag_api:
        condition: service_started
    image: "{{ librechat__image_api }}"
    restart: always
    user: "{{ librechat__container_uid }}:{{ librechat__container_gid }}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - HOST=0.0.0.0
      - MONGO_URI=mongodb://mongodb:27017/LibreChat
      - MEILI_HOST=http://meilisearch:7700
      - RAG_PORT={{ librechat__rag_port }}
      - RAG_API_URL=http://rag_api:{{ librechat__rag_port }}
    # Use env_file (read by docker compose on the host running compose) — do not bind-mount .env.
    # Bind mounts are resolved on the Docker *daemon* host; with a remote/socket daemon (e.g. Molecule)
    # the file under librechat__home may not exist there and Docker can create a directory, breaking
    # mounts onto /app/.env (file in the image).
    env_file:
      - "{{ librechat__home }}/.env"
    volumes:
      - "{{ librechat__home }}/librechat.yaml:/app/librechat.yaml:ro"
      - "{{ librechat__home }}/images:/app/client/public/images"
      - "{{ librechat__home }}/uploads:/app/uploads"
      - "{{ librechat__home }}/logs:/app/logs"
    logging:
      driver: "{{ librechat__log_driver }}"
      options: {{ librechat__log_options | to_nice_json }}

  mongodb:
    container_name: chat-mongodb
    networks:
      - librechat_net
    image: "{{ librechat__image_mongodb }}"
    restart: always
    user: "{{ librechat__container_uid }}:{{ librechat__container_gid }}"
    volumes:
      - "{{ librechat__home }}/data-node:/data/db"
    command: mongod --noauth
    healthcheck:
      # mongo:4.4: legacy `mongo` client. 5.0+: `mongosh`. Try `mongo` first so a slow/hanging `mongosh` on 4.4 does not
      # burn the whole healthcheck timeout before the fallback runs. Explicit TCP avoids socket/path quirks with `user:`.
      test: ["CMD-SHELL", "mongo --quiet --host 127.0.0.1 --port 27017 --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1 || mongosh --quiet --host 127.0.0.1 --port 27017 --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1"]
      interval: 5s
      timeout: 10s
      retries: 18
      start_period: 60s
    logging:
      driver: "{{ librechat__log_driver }}"
      options: {{ librechat__log_options | to_nice_json }}

  meilisearch:
    container_name: chat-meilisearch
    networks:
      - librechat_net
    image: "{{ librechat__image_meilisearch }}"
    restart: always
    user: "{{ librechat__container_uid }}:{{ librechat__container_gid }}"
    environment:
      - MEILI_HOST=http://meilisearch:7700
      - MEILI_NO_ANALYTICS=true
      - MEILI_MASTER_KEY={{ librechat__meili_master_key }}
    volumes:
      - "{{ librechat__home }}/meili_data:/meili_data"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:7700/health >/dev/null"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 15s
    logging:
      driver: "{{ librechat__log_driver }}"
      options: {{ librechat__log_options | to_nice_json }}

  vectordb:
    container_name: vectordb
    networks:
      - librechat_net
    image: "{{ librechat__image_vectordb }}"
    environment:
      POSTGRES_DB: "{{ librechat__vectordb_db }}"
      POSTGRES_USER: "{{ librechat__vectordb_user }}"
      POSTGRES_PASSWORD: "{{ librechat__vectordb_password }}"
    restart: always
    volumes:
      - librechat_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ librechat__vectordb_user | quote }} -d {{ librechat__vectordb_db | quote }}"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 20s
    logging:
      driver: "{{ librechat__log_driver }}"
      options: {{ librechat__log_options | to_nice_json }}

  rag_api:
    container_name: rag_api
    networks:
      - librechat_net
    image: "{{ librechat__image_rag_api }}"
    environment:
      - DB_HOST=vectordb
      - RAG_PORT={{ librechat__rag_port }}
    restart: always
    depends_on:
      vectordb:
        condition: service_healthy
    env_file:
      - "{{ librechat__home }}/.env"
    logging:
      driver: "{{ librechat__log_driver }}"
      options: {{ librechat__log_options | to_nice_json }}

volumes:
  librechat_pgdata: {}
